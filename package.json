{
  "name": "letscoding-editor",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build --webpack",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test && EDITOR_AUTH_TEST=true playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:env": "node --import tsx scripts/check-env.ts",
    "predev": "node scripts/prepare-monaco.mjs",
    "prebuild": "node scripts/prepare-monaco.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/supabase-js": "^2.101.1",
    "ai": "^7.0.68",
    "dompurify": "^3.4.16",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "marked": "^18.0.6",
    "monaco-editor": "^0.57.0",
    "next": "^16.3.8",
    "prettier": "^3.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
