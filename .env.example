# cp .env.example .env.local
# No accounts are needed for npm run dev with demo enabled.
# Production always disables demo. Fill staging keys for local/Preview first.
NEXT_PUBLIC_APP_URL=http://localhost:3100
EDITOR_DEMO_MODE=true
# Autosave interval in milliseconds (default 60000, allowed 1000-600000).
EDITOR_AUTOSAVE_MS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set budgets after development; a key alone never activates paid AI.
EDITOR_AI_ENABLED=false
EDITOR_IMAGE_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CODE=
OPENROUTER_MODEL_AUX=
OPENROUTER_MODEL_VISION=
OPENROUTER_MODEL_IMAGE=
EDITOR_AI_DAILY_LIMIT_USD=
EDITOR_AI_MONTHLY_LIMIT_USD=
EDITOR_AI_MAX_TURN_USD=
# Conservative allowances must be measured for the selected multimodal models.
EDITOR_AI_IMAGE_INPUT_RESERVE_USD=
EDITOR_AI_IMAGE_OUTPUT_RESERVE_USD=

EDITOR_DEPLOY_ENABLED=false
LOUNGE_INTERNAL_API_URL=
LOUNGE_INTERNAL_API_SECRET=

# Optional; DSN is an ingest address, not an admin credential.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
CRON_SECRET=

# Student-owned Supabase project links (public URL + anon key stored in the project snapshot).
# Needs the lounge migration from integration/supabase-link-schema.sql. Demo mode works without it.
EDITOR_SUPABASE_LINK_ENABLED=false

# Student-owned GitHub repositories (GitHub App user authorization, not editor login).
EDITOR_GITHUB_ENABLED=false
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters; used only on the server.
GITHUB_COOKIE_KEY=

# Server-only AES-256-GCM key for administrator DB connections (64 hex characters).
# Back up securely; changing this key requires reconnecting administrator DBs.
EDITOR_SUPABASE_ADMIN_KEY=
