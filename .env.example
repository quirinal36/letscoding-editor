# cp .env.example .env.local
# No accounts are needed for npm run dev with demo enabled.
# Production always disables demo. Fill staging keys for local/Preview first.
NEXT_PUBLIC_APP_URL=http://localhost:3100
EDITOR_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set budgets after development; a key alone never activates paid AI.
EDITOR_AI_ENABLED=false
EDITOR_IMAGE_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL_CODE=
OPENROUTER_MODEL_AUX=
OPENROUTER_MODEL_VISION=
OPENROUTER_MODEL_IMAGE=
EDITOR_AI_DAILY_LIMIT_USD=
EDITOR_AI_MONTHLY_LIMIT_USD=
EDITOR_AI_MAX_TURN_USD=
# Conservative allowances must be measured for the selected multimodal models.
EDITOR_AI_IMAGE_INPUT_RESERVE_USD=
EDITOR_AI_IMAGE_OUTPUT_RESERVE_USD=

EDITOR_DEPLOY_ENABLED=false
LOUNGE_INTERNAL_API_URL=
LOUNGE_INTERNAL_API_SECRET=

# Optional; DSN is an ingest address, not an admin credential.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
CRON_SECRET=
